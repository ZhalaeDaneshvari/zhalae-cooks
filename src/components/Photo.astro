---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; eager?: boolean; class?: string; sizes?: string; }
const { src, alt, eager = false, class: className, sizes = '(max-width: 700px) calc((100vw - 58px) / 2), (max-width: 1050px) 45vw, 400px' } = Astro.props;
const widths = [...new Set([360, 640, 960, 1280, 1600].map(width => Math.min(width, src.width)))];
---
<Image data-original-src={src.src} src={src} alt={alt} class={className} width={Math.min(960, src.width)} widths={widths} sizes={sizes} format="webp" quality={78} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : 'auto'}/>

<script>
  // Recover if an optimized image cannot load or decode in the visitor’s browser.
  const recover = (image: EventTarget | null) => {
    if (!(image instanceof HTMLImageElement) || !image.dataset.originalSrc) return;
    const original = image.dataset.originalSrc;
    delete image.dataset.originalSrc;
    image.removeAttribute('srcset');
    image.removeAttribute('sizes');
    image.src = original;
  };
  document.addEventListener('error', event => recover(event.target), true);
  document.querySelectorAll<HTMLImageElement>('img[data-original-src]').forEach(image => {
    if (image.complete && image.naturalWidth === 0) recover(image);
  });
</script>
