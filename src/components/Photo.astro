---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; eager?: boolean; class?: string; sizes?: string; }
const { src, alt, eager = false, class: className, sizes = '(max-width: 600px) 100vw, (max-width: 1000px) 50vw, 40vw' } = Astro.props;
---
<Image src={src} alt={alt} class={className} widths={[360, 640, 960, 1440]} sizes={sizes} format="webp" quality={82} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : 'auto'} />
