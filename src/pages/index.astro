---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import DishCard from '../components/DishCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { publicDishes, publicJournal, dishUrl, href, dateLabel } from '../lib';
import spotlightIds from '../data/spotlight-imports.json';
import { siteConfig } from '../config';
const dishes = await publicDishes();
const journals = await publicJournal();
const hero = dishes.find(d => d.data.importId === '18604677808015700') || dishes[0];
const small = dishes.find(d => d.data.importId === '18121862992680182') || dishes[1];
const latest = spotlightIds.flatMap(id => dishes.filter(d => d.data.importId === id));
const explore = dishes.filter(d => !latest.includes(d)).slice(0, 7);
---
<Layout image={hero?.data.heroImage.src}>
  <section class="hero wrap">
    <div class="hero-copy"><p class="eyebrow">A personal food journal</p><h1>Good food.<br/>A little curiosity.<br/><em>My kitchen.</em></h1><p class="hero-intro">{siteConfig.intro}</p><a class="text-link" href={href('recipes/')}>Come see what’s cooking <span aria-hidden="true">↗</span></a><span class="hero-number" aria-hidden="true">A collection, one plate at a time.</span></div>
    {hero && <div class="hero-photos"><a class="hero-main" href={dishUrl(hero)}><Photo src={hero.data.heroImage} alt={hero.data.heroAlt} eager sizes="(max-width: 700px) 85vw, 47vw"/><span class="hero-photo-caption">On the table <span>Razor clam pasta ↗</span></span></a>{small && <a class="hero-small" href={dishUrl(small)}><Photo src={small.data.heroImage} alt={small.data.heroAlt} eager sizes="(max-width: 700px) 40vw, 22vw"/><span>Another helping of octopus bruschetta.</span></a>}<div class="round-note" aria-hidden="true">always<br/><em>something</em><br/>cooking</div></div>}
  </section>
  <div class="section-rule wrap"><span>Cook. Taste. Make it again.</span><span>Welcome to the table.</span></div>
  <section class="latest-section wrap"><div class="section-heading"><div><p class="eyebrow">A few personal favorites</p><h2>Made with <em>a lot of love</em></h2></div><a class="text-link" href={href('recipes/')}>View the collection ↗</a></div><div class="spotlight-grid">{latest.map((dish, index) => <DishCard dish={dish} index={index}/>)}</div></section>
  <section class="explore-section"><div class="section-heading wrap"><div><p class="eyebrow">Follow your appetite</p><h2>Explore <em>the kitchen</em></h2></div><p class="muted">A few things worth a second helping.<br/><span class="small">Scroll to find something good →</span></p></div><div class="photo-strip" tabindex="0" role="region" aria-label="Explore dishes, scroll horizontally">{explore.map((dish, index) => <DishCard dish={dish} index={index}/>)}</div></section>
  <section class="personal-section wrap"><span class="eyebrow">The person behind the plate</span><div><h2>Hi, I’m {siteConfig.authorName}.<br/><em>Welcome to my kitchen.</em></h2><p>I learned to cook from my dad, and I cook just like him: a little of this, a little of that, and almost never a recipe. Most of what you’ll find here is a dish and a photograph. Written recipes are coming—as soon as I remember to measure.</p><a class="text-link" href={href('about/')}>Meet my first cooking inspiration ↗</a></div><span class="personal-signature" aria-hidden="true">Z.</span></section>
  <section class="journal-preview wrap"><div class="section-heading"><div><p class="eyebrow">Beyond the recipe</p><h2>The kitchen <em>journal</em></h2></div><a class="text-link" href={href('journal/')}>All notes ↗</a></div>{journals.length ? journals.slice(0, 2).map(post => <a class="journal-row" href={href(`journal/${post.data.slug}/`)}><time>{dateLabel(post.data.date)}</time><h3>{post.data.title}</h3><span aria-hidden="true">↗</span></a>) : <div class="journal-empty"><span class="issue-number">01 /</span><div><h3>There’s more to a meal than a recipe.</h3><p>Kitchen experiments, little discoveries, and stories behind the dishes. The first notes are still to come.</p></div><a class="text-link" href={href('recipes/')}>Explore the photographs ↗</a></div>}</section>
  <div class="wrap"><Newsletter/></div>
  <section class="instagram-line wrap"><p>More of the everyday, over on Instagram.</p><a class="text-link" href={siteConfig.instagramUrl}>@zhalae.cooks ↗</a></section>
</Layout>
