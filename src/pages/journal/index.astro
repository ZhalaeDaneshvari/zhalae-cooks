---
import Arrow from '../../components/Arrow.astro';
import Layout from '../../layouts/Layout.astro';
import Newsletter from '../../components/Newsletter.astro';
import { publicJournal, href, dateLabel } from '../../lib';
const posts = await publicJournal();
---
<Layout title="The kitchen journal" description="Experiments, discoveries, and stories from the kitchen."><div class="wrap"><header class="page-heading"><p class="eyebrow">Notes, discoveries & little obsessions</p><h1>The kitchen <em>journal</em></h1><p>My little corner for cooking thoughts, favorite methods, and the things I keep making. Start with steak, or see what’s new.</p></header><nav class="journal-shortcuts" aria-label="Journal shortcuts"><a class="button" href={href("journal/how-i-cook-my-steaks/")}>Start with my steak notes <Arrow direction="right"/></a><a class="text-link" href={href("recipes/")}>Browse the dishes <Arrow direction="up-right"/></a></nav><section class="journal-index">{posts.length ? posts.map(post => <a class="journal-row" href={href(`journal/${post.data.slug}/`)}><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><h3>{post.data.title}</h3><span aria-hidden="true"><Arrow direction="up-right"/></span></a>) : <div class="empty-state"><p class="eyebrow">A fresh page</p><h2>The first notes<br/>are <em>still simmering.</em></h2><p>Cooking experiments, favorite ingredients, and stories behind the dishes. There’s plenty to photograph while the words catch up.</p><a class="text-link" href={href('recipes/')}>See what’s been cooking <Arrow direction="up-right"/></a></div>}</section><Newsletter/></div></Layout>
