---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Newsletter from '../components/Newsletter.astro';
import { href } from '../lib';
import { siteConfig } from '../config';
import about from '../data/about.json';
import dadAndMe from '../assets/about/dad-and-me.jpg';
import littleMe from '../assets/about/little-me-at-the-table.jpg';
import dadToday from '../assets/about/family-kitchen.jpg';
---
<Layout title="A little about me" description={about.description} image={dadAndMe.src}>
  <div class="wrap">
    <section class="about-intro">
      <div class="about-intro-copy"><p class="eyebrow">Hello, I’m {siteConfig.authorName}</p><h1>Cooking what<br/>I love, <em>for the<br/>people I love.</em></h1><p class="about-lede">{about.description}</p><span class="album-note">A little family album, a lot of love.</span></div>
      <div class="family-album">
        <figure class="album-photo dad-and-me"><Photo src={dadAndMe} alt="Zhalae as a toddler, smiling in her dad’s arms" eager sizes="(max-width: 700px) 90vw, 45vw"/><figcaption>{about.babyCaption}</figcaption></figure>
        <figure class="album-photo little-me"><div class="childhood-closeup"><Photo src={littleMe} alt="Little Zhalae at the family dinner table, raising a fork and both arms with a big smile" eager sizes="(max-width: 700px) 85vw, 40vw"/></div><figcaption>{about.forkCaption}<span class="handwritten-arrow" aria-hidden="true">↖ that’s me!</span></figcaption></figure>
      </div>
    </section>
    <div class="section-rule"><span>Like father, like daughter.</span><span>A pinch of this. A whole lot of love.</span></div>
    <section class="dad-story">
      <figure class="dad-portrait"><Photo src={dadToday} alt="Zhalae’s dad smiling in his apron behind a chocolate and raspberry cake" sizes="(max-width: 700px) 90vw, 38vw"/><figcaption>{about.dadCaption}</figcaption></figure>
      <div class="dad-story-copy"><p class="eyebrow">Where it all began</p><h2>{about.dadHeading}</h2><p>{about.dadStory}</p><h3>{about.instinctHeading}</h3><p>{about.instinctStory}</p><p class="family-signoff">Same instinct. Same love of feeding people.</p></div>
    </section>
    <section class="recipe-letter"><p class="eyebrow">A small note about recipes</p><div><h2>{about.recipeHeading}</h2><p>{about.recipeStory}</p><a class="text-link" href={href('recipes/')}>Take a look at what’s cooking ↗</a></div></section>
    <Newsletter/>
  </div>
</Layout>
