---
import Layout from '../../layouts/Layout.astro';
import DishCard from '../../components/DishCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import { publicDishes } from '../../lib';
const dishes = await publicDishes();
---
<Layout title="The collection" description="Browse dishes, food photographs, and recipes from Zhalae’s kitchen.">
  <div class="wrap"><header class="page-heading"><p class="eyebrow">Something for every appetite</p><h1>From <em>my kitchen</em></h1><p>I cook by eye and by taste, just like my dad. Most of these are dishes and photographs, not written recipes just yet. A few recipes are coming as I start putting measurements to the meals I love.</p></header>
  <form class="filters" role="search" onsubmit="return false"><div class="filter-top"><label class="search-field" for="dish-search">Find something delicious<input id="dish-search" type="search" placeholder="Search dishes, ingredients, notes…" autocomplete="off"/></label><label class="filter-select" for="category">On the menu<select id="category"><option value="">All categories</option>{['Breakfast','Lunch','Dinner','Dessert','Sides','Drinks','Other'].map(c => <option>{c}</option>)}</select></label></div><div class="type-filters" role="group" aria-label="Entry type">{['All','Recipes','Dishes','Favorites'].map((type, index) => <button type="button" data-type={type} aria-pressed={index === 0}>{type}</button>)}</div></form>
  <p class="results-count" id="results-count" role="status" aria-live="polite">{dishes.length} things from the kitchen</p>
  <h2 class="sr-only">Dishes and recipes</h2><div class="collection-grid" id="collection">{dishes.map(dish => <div data-entry data-search={[dish.data.title,dish.data.description,dish.data.originalCaption,...dish.data.tags].filter(Boolean).join(' ').toLowerCase()} data-category={dish.data.category} data-recipe={dish.data.hasRecipe} data-favorite={dish.data.favorite}><DishCard dish={dish}/></div>)}</div>
  <div class="empty-state" id="no-results" hidden><h2>Nothing on the table <em>just yet.</em></h2><p id="empty-copy">Try another search or explore all the dishes.</p><button class="button" id="reset-filters" type="button">Show all dishes</button></div>
  <noscript><p class="small">All dishes are shown. Enable JavaScript to search and filter this collection.</p></noscript>
  <Newsletter/></div>
</Layout>
<script>
  const search = document.querySelector<HTMLInputElement>('#dish-search')!;
  const category = document.querySelector<HTMLSelectElement>('#category')!;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-type]')];
  const entries = [...document.querySelectorAll<HTMLElement>('[data-entry]')];
  let type = 'All';
  const normalize = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  function update() {
    const terms = normalize(search.value.trim()).split(/\s+/).filter(Boolean);
    let count = 0;
    for (const entry of entries) {
      const matches = terms.every(term => normalize(entry.dataset.search || '').includes(term)) && (!category.value || entry.dataset.category === category.value) && (type === 'All' || (type === 'Recipes' && entry.dataset.recipe === 'true') || (type === 'Dishes' && entry.dataset.recipe === 'false') || (type === 'Favorites' && entry.dataset.favorite === 'true'));
      entry.hidden = !matches; if (matches) count++;
    }
    document.querySelector('#results-count')!.textContent = `${count} ${count === 1 ? 'thing' : 'things'} from the kitchen`;
    document.querySelector<HTMLElement>('#no-results')!.hidden = count > 0;
    document.querySelector<HTMLElement>('#collection')!.hidden = count === 0;
    document.querySelector('#empty-copy')!.textContent = type === 'Recipes' ? 'I usually eyeball everything, so written recipes are still to come. For now, explore the dishes and photographs.' : 'Try another search or explore all the dishes.';
    const params = new URLSearchParams(); if (search.value) params.set('q',search.value); if (category.value) params.set('category',category.value); if (type !== 'All') params.set('type',type);
    history.replaceState(null,'',location.pathname + (params.size ? `?${params}` : ''));
  }
  for (const button of buttons) button.addEventListener('click', () => { type = button.dataset.type!; buttons.forEach(b => b.setAttribute('aria-pressed',String(b === button))); update(); });
  search.addEventListener('input',update); category.addEventListener('change',update);
  document.querySelector('#reset-filters')!.addEventListener('click', () => { search.value=''; category.value=''; type='All'; buttons.forEach(b => b.setAttribute('aria-pressed',String(b.dataset.type === type))); update(); search.focus(); });
  const params = new URLSearchParams(location.search); search.value = params.get('q') || ''; category.value = params.get('category') || ''; type = ['All','Recipes','Dishes','Favorites'].includes(params.get('type') || '') ? params.get('type')! : 'All'; buttons.forEach(b => b.setAttribute('aria-pressed',String(b.dataset.type === type))); update();
</script>
